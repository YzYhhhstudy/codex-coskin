#!/bin/zsh
# CoSkin.app —— 双击（或点 Dock 图标）= 打开带皮肤的 Codex：更新 + 恢复你上次用的主题。
# 无终端窗口；需要重启 Codex 确认时会弹系统对话框（--gui）。换主题/自定义配色都在 Codex 右下角 🎨 面板。
# 这个 .app 放在仓库文件夹（codex-coskin/）里，靠自身位置找到仓库根。

SELF="$(cd "$(dirname "$0")" && pwd)"           # …/CoSkin.app/Contents/MacOS
DIR="$(cd "$SELF/../../.." && pwd)"             # 仓库根（codex-coskin/）

# 准备运行环境：有 node 就用；没有就免密下载绿色版到 ~/.coskin（首次约 50MB）。
# GUI 启动的 App 环境 PATH 很干净，nvm/homebrew/volta 的查找都在 ensure-node.sh 里做了；
# 下载期间它会发系统通知，免得无窗口启动看起来像卡死。
NODE="$(sh "$DIR/scripts/ensure-node.sh")" || {
  osascript -e 'display dialog "准备运行环境失败。请检查网络后重新打开 CoSkin。" with title "CoSkin" buttons {"好"} default button "好"' >/dev/null 2>&1
  exit 1
}

# 打开带皮肤的 Codex：更新 + 恢复上次主题；确认 / 报错 / 完成提示都走系统弹窗
# （装 Codex 技能已收进 node 侧 resume，幂等且原子写入，不再在这里做）
exec "$NODE" "$DIR/src/coskin.mjs" resume --update --gui
